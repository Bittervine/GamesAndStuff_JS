{
  "name": "ignatius-devtool-electron",
  "version": "1.0.0",
  "private": true,
  "description": "Experimental Electron host for the Ignatius development tools.",
  "main": "main.cjs",
  "scripts": {
    "start": "set ELECTRON_RUN_AS_NODE=&& electron .",
    "electron": "set ELECTRON_RUN_AS_NODE=&& electron .",
    "build": "node build-package.cjs",
    "build:win-portable": "node build-package.cjs",
    "build:win-dir": "node build-package.cjs --dir"
  },
  "devDependencies": {
    "electron": "42.5.0",
    "electron-builder": "^26.8.1"
  }
}
