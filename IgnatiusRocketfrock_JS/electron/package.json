{
  "name": "ignatius-rocketfrock-electron",
  "version": "1.0.0",
  "private": true,
  "description": "Portable Electron packaging for Ignatius Rocketfrock.",
  "main": "main.cjs",
  "scripts": {
    "start": "set ELECTRON_RUN_AS_NODE=&& electron .",
    "electron": "set ELECTRON_RUN_AS_NODE=&& electron .",
    "build": "node build-package.cjs",
    "build:win-portable": "node build-package.cjs",
    "build:win-dir": "node build-package.cjs --dir"
  },
  "devDependencies": {
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1"
  }
}
