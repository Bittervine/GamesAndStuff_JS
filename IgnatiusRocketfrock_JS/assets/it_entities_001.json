    "mailbox": {
      "type": "mailbox",
      "label": "Editor's mailbox",
      "icon": "\ud83d\udcec",
      "description": "An editor-letter mailbox. Each placed mailbox owns its own trigger distance, letter, thought, and timing metadata, so a level can contain several tutorial letters.",
      "defaultState": "letterAvailable",
      "defaultSize": {
        "w": 110,
        "h": 158
      },
      "defaults": {
        "interaction": "editorLetter",
        "triggerDistance": 72,
        "letterDuration": 14,
        "thoughtDuration": 9,
        "letterAtlasId": "it_atlas_001",
        "letterAssetId": "letter_scroll",
        "thoughtAtlasId": "it_atlas_001",
        "thoughtAssetId": "thought_bubble_large",
        "letterTitle": "A Letter from Your Humble Editor",
        "letterText": "Dear Ignatius,\n\nI hope this letter finds you well, and with most of your limbs still attached. I look forward to receiving the first chapter of your travel book shortly. I have even come up with a great title: \u201cIgnatius Rocketfrock and the Introductory Cave of Training.\u201d Please proceed boldly!\n\nSincerely,\nYour humble editor,\nWilfred of Bittervine",
        "thoughtText": "How kind of him! I hope I can make him proud. This cave doesn\u2019t look quite like it did in the brochures, but I\u2019m sure it will be fine."
      },
      "states": {
        "letterAvailable": {
          "label": "Letter available",
          "visuals": [
            {
              "atlasId": "it_atlas_001",
              "assetId": "mailbox_with_letter",
